# Leave everything blank to run fully offline (keyword embeddings + extractive answers).

# auto | azure | openai | offline
LLM_PROVIDER=auto

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Optional: an embedding deployment (e.g. text-embedding-3-small). Without it, keyword embeddings are used.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

TOP_K=4
COURSEKIT_DB=coursekit.db
# Pin "today" for demos (YYYY-MM-DD). Blank = real date.
COURSEKIT_TODAY=
